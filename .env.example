# PulseCloud Environment Configuration
ENVIRONMENT=development
SECRET_KEY=change-this-to-a-secure-random-32-byte-secret-in-production!
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL in Production, SQLite fallback for zero-dependency local dev)
DATABASE_URL=sqlite:///./pulsecloud.db
# DATABASE_URL=postgresql://pulsecloud:pulsecloud123@localhost:5432/pulsecloud

# Redis & Background Workers
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Scheduler Mode: 'asyncio' (built-in zero-dependency scheduler) or 'celery'
SCHEDULER_MODE=asyncio

# Monitoring Engine Parameters
REQUEST_DEFAULT_TIMEOUT=10.0
MAX_RESPONSE_BODY_BYTES=10240
CONSECUTIVE_FAILURES_FOR_DOWN=2
LATENCY_DEGRADED_THRESHOLD_MS=800.0
ALERT_COOLDOWN_MINUTES=15
CHECK_RETENTION_DAYS=30

# SSRF Cybersecurity Policy
SSRF_BLOCK_PRIVATE_NETWORKS=true
ALLOW_HTTP_FOR_MONITORING=true

# Demo Data
SEED_DEMO_DATA=true
